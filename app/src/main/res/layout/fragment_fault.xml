<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="800dp"
    android:layout_height="380dp"
    tools:context=".pages.FaultFragment">

    <TextView
        android:id="@+id/textViewFaultMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawablePadding="20dp"
        android:gravity="center"
        android:text="@string/faultMessage"
        android:textSize="32sp"
        android:textColor="#760505"
        android:textStyle="bold"
        app:drawableStartCompat="@drawable/fault"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/textViewFaultCode"
        android:layout_width="650dp"
        android:layout_height="260dp"
        android:layout_marginTop="20dp"
        android:padding="10dp"
        android:gravity="start"
        android:textSize="30sp"
        android:textColor="@color/white"
        android:background="@color/gin_grey"
        app:layout_constraintTop_toBottomOf="@id/textViewFaultMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>