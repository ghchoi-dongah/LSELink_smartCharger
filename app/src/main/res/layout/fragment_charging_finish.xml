<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="800dp"
    android:layout_height="380dp"
    tools:context=".pages.ChargingFinishFragment">

    <TextView
        android:id="@+id/textViewChargingFinishMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/chargingFinishMessage"
        android:textSize="34sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewSocValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="80%"
        android:textSize="58sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textViewChargingFinishMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imageViewSoc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="232dp"
        android:background="@drawable/soc"
        app:layout_constraintTop_toTopOf="@id/textViewSocValue"
        app:layout_constraintBottom_toBottomOf="@id/textViewSocValue"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="contentDescription"/>

    <TextView
        android:id="@+id/textViewLimitSocValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="목표 충전율: 90%"
        android:textSize="22sp"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="@id/imageViewSoc"
        app:layout_constraintStart_toEndOf="@id/imageViewSoc"
        app:layout_constraintBottom_toBottomOf="@id/imageViewSoc" />


    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="680dp"
        android:layout_height="130dp"
        android:layout_marginTop="6dp"
        app:strokeColor="@color/primary"
        app:strokeWidth="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewSocValue">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <View
                android:id="@+id/viewLine"
                android:layout_width="2dp"
                android:layout_height="120dp"
                android:layout_marginTop="5dp"
                android:background="#E7E7E7"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/textViewChargingAmt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/chargeOfAmount"
                android:textSize="28sp"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/textViewChargingAmtValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:text="100.00 kWh"
                android:textSize="28sp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/viewLine"
                app:layout_constraintTop_toTopOf="@id/textViewChargingAmt"
                app:layout_constraintBottom_toBottomOf="@id/textViewChargingAmt"/>

            <TextView
                android:id="@+id/textViewChargingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/chargingTime"
                android:textSize="28sp"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="@id/textViewChargingAmt"
                app:layout_constraintTop_toBottomOf="@id/textViewChargingAmt"/>

            <TextView
                android:id="@+id/textViewChargingTimeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textSize="28sp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/textViewChargingAmtValue"
                app:layout_constraintTop_toTopOf="@id/textViewChargingTime"
                app:layout_constraintBottom_toBottomOf="@id/textViewChargingTime"
                tools:ignore="RtlHardcoded" />

            <TextView
                android:id="@+id/textViewMoneyContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="@string/chargeAmount"
                android:textSize="28sp"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="@id/viewLine"
                app:layout_constraintTop_toTopOf="@id/textViewChargingAmt"/>

            <TextView
                android:id="@+id/txtChargePay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="120,999 원"
                android:textSize="28sp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/textViewMoneyContent"
                app:layout_constraintBottom_toBottomOf="@id/textViewMoneyContent"
                tools:ignore="RtlHardcoded" />

            <TextView
                android:id="@+id/txtUnitTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/chargingUnit"
                android:textSize="28sp"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="@id/textViewMoneyContent"
                app:layout_constraintTop_toBottomOf="@id/textViewMoneyContent" />

            <TextView
                android:id="@+id/txtPowerUnitPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="222 원"
                android:textSize="28sp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/txtChargePay"
                app:layout_constraintTop_toTopOf="@id/txtUnitTitle"
                app:layout_constraintBottom_toBottomOf="@id/txtUnitTitle" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnCheck"
        android:layout_width="320dp"
        android:layout_height="80dp"
        android:layout_marginBottom="10dp"
        android:text="@string/check"
        android:textSize="28sp"
        android:textColor="@color/white"
        android:background="@drawable/shape_btn_blue"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>