<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="800dp"
    android:layout_height="380dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    tools:context=".pages.AuthSelectFragment">

    <!-- 상단 행: Q2(회원) | Q1(비회원) — authMode 0에서 rowBottom GONE → gravity로 수직 중앙 정렬 -->
    <LinearLayout
        android:id="@+id/rowTop"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- 왼쪽 여백: authMode 1에서만 표시 → cardMember 가운데 정렬 -->
        <View
            android:id="@+id/spacerLeft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- Q2: 회원 — 항상 표시 -->
        <LinearLayout
            android:id="@+id/cardMember"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:layout_marginEnd="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/layer_list_rect_corner"
            tools:ignore="NestedWeights">

            <!-- 왼쪽: 아이콘 -->
            <ImageView
                android:id="@+id/imageViewMember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/member"
                android:scaleType="fitCenter"
                tools:ignore="contentDescription" />

            <!-- 가운데+오른쪽: 문구 그룹 (단가를 회원 문구와 같은 행에 배치) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <!-- 회원충전 문구 + 단가를 같은 행에 배치 → top 자동 정렬 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textViewMember"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/memberMessage"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/black_500" />

                    <TextView
                        android:id="@+id/textViewMemberUnitInput"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textViewMemberContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/memberInfoMessage"
                    android:textSize="20sp"
                    android:textColor="@color/black_500" />
            </LinearLayout>
        </LinearLayout>

        <!-- Q1: 비회원 — authMode 0·2에서 표시, authMode 1에서 GONE -->
        <LinearLayout
            android:id="@+id/cardNoMember"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:layout_marginStart="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/layer_list_rect_corner"
            tools:ignore="NestedWeights">

            <!-- 왼쪽: 아이콘 -->
            <ImageView
                android:id="@+id/imageViewNoMember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/nomember"
                android:scaleType="fitCenter"
                tools:ignore="contentDescription" />

            <!-- 가운데+오른쪽: 문구 그룹 (단가를 비회원 문구와 같은 행에 배치) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <!-- 비회원충전 문구 + 단가를 같은 행에 배치 → top 자동 정렬 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textViewNoMember"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nomemberMessage"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/black_500" />

                    <TextView
                        android:id="@+id/textViewNoMemberUnitInput"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textViewNoMemberContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/nomemberInfoMessage"
                    android:textSize="20sp"
                    android:textColor="@color/black_500" />
            </LinearLayout>
        </LinearLayout>

        <!-- 오른쪽 여백: authMode 1에서만 표시 → cardMember 가운데 정렬 -->
        <View
            android:id="@+id/spacerRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 하단 행: Q3(법인) | Q4(환경부) — authMode 0에서 GONE -->
    <LinearLayout
        android:id="@+id/rowBottom"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <!-- Q3: 법인 -->
        <LinearLayout
            android:id="@+id/cardCorp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/layer_list_rect_corner"
            tools:ignore="NestedWeights">

            <!-- 왼쪽: 아이콘 -->
            <ImageView
                android:id="@+id/imageViewCorporate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/corp"
                android:scaleType="fitCenter"
                tools:ignore="contentDescription" />

            <!-- 가운데+오른쪽: 문구 그룹 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textViewCorporate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/corpMessage"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/black_500" />

                    <TextView
                        android:id="@+id/textViewCorporateUnitInput"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textViewCorporateContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/corpInfoMessage"
                    android:textSize="20sp"
                    android:textColor="@color/black_500" />
            </LinearLayout>
        </LinearLayout>

        <!-- Q4: 환경부 -->
        <LinearLayout
            android:id="@+id/cardMoe"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/layer_list_rect_corner"
            tools:ignore="NestedWeights">

            <!-- 왼쪽: 아이콘 -->
            <ImageView
                android:id="@+id/imageViewEnvironment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/moe"
                android:scaleType="fitCenter"
                tools:ignore="contentDescription" />

            <!-- 가운데+오른쪽: 문구 그룹 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textViewEnvironment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/moeMessage"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/black_500" />

                    <TextView
                        android:id="@+id/textViewEnvironmentUnitInput"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textViewEnvironmentContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/moeInfoMessage"
                    android:textSize="20sp"
                    android:textColor="@color/black_500" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
