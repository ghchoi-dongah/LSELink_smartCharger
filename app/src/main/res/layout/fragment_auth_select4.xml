<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="800dp"
    android:layout_height="380dp"
    tools:context=".pages.AuthSelect4Fragment">

    <!--  환경부  -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewMoe"
        android:layout_width="370dp"
        android:layout_height="140dp"
        android:layout_marginTop="40dp"
        android:layout_marginStart="20dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMoe"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/layer_list_rect_corner">

            <TextView
                android:id="@+id/textViewMoe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="-10dp"
                android:text="@string/moeMessage"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/green"
                app:layout_constraintTop_toTopOf="@id/imageViewMoe"
                app:layout_constraintStart_toEndOf="@id/imageViewMoe" />

            <ImageView
                android:id="@+id/imageViewMoe"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/moe"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:ignore="contentDescription" />

            <TextView
                android:id="@+id/textViewMoeUnitInput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:text="0원/kWh"
                android:textSize="18sp"
                android:textColor="@color/black_600"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/textViewMoeContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start"
                android:text="@string/moeInfoMessage"
                android:textSize="20sp"
                android:textColor="@color/gray_500"
                app:layout_constraintStart_toStartOf="@id/textViewMoe"
                app:layout_constraintTop_toBottomOf="@id/textViewMoe" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>


    <!--  법인  -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewCorp"
        android:layout_width="370dp"
        android:layout_height="140dp"
        android:layout_marginStart="20dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="@id/cardViewMoe"
        app:layout_constraintStart_toEndOf="@id/cardViewMoe" >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutCorp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/layer_list_rect_corner">

            <TextView
                android:id="@+id/textViewCorp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="-10dp"
                android:text="@string/corpMessage"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/blue_900"
                app:layout_constraintTop_toTopOf="@id/imageViewCorp"
                app:layout_constraintStart_toEndOf="@id/imageViewCorp"/>

            <ImageView
                android:id="@+id/imageViewCorp"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/corp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:ignore="contentDescription" />

            <TextView
                android:id="@+id/textViewCorpUnitInput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:text="0원/kWh"
                android:textSize="18sp"
                android:textColor="@color/black_600"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewCorpContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start"
                android:text="@string/corpInfoMessage"
                android:textSize="20sp"
                android:textColor="@color/gray_500"
                app:layout_constraintStart_toStartOf="@id/textViewCorp"
                app:layout_constraintTop_toBottomOf="@id/textViewCorp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>


    <!-- member info -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewMember"
        android:layout_width="370dp"
        android:layout_height="140dp"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="@id/cardViewMoe"
        app:layout_constraintTop_toBottomOf="@id/cardViewMoe">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMember"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/layer_list_rect_corner">

            <TextView
                android:id="@+id/textViewMember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="-10dp"
                android:text="@string/memberMessage"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                app:layout_constraintTop_toTopOf="@id/imageViewMember"
                app:layout_constraintStart_toEndOf="@id/imageViewMember"  />

            <ImageView
                android:id="@+id/imageViewMember"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/member"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:ignore="contentDescription" />

            <TextView
                android:id="@+id/textViewMemberUnitInput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:text="0원/kWh"
                android:textSize="18sp"
                android:textColor="@color/black_600"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewMemberContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start"
                android:text="@string/memberInfoMessage"
                android:textSize="20sp"
                android:textColor="@color/gray_500"
                app:layout_constraintTop_toBottomOf="@id/textViewMember"
                app:layout_constraintStart_toStartOf="@id/textViewMember" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- nomember info -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewNoMember"
        android:layout_width="370dp"
        android:layout_height="140dp"
        android:layout_marginStart="20dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="@id/cardViewMember"
        app:layout_constraintStart_toEndOf="@id/cardViewMember">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutNoMember"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/layer_list_rect_corner">

            <TextView
                android:id="@+id/textViewNoMember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="-10dp"
                android:text="@string/nomemberMessage"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/yellow_900"
                app:layout_constraintTop_toTopOf="@id/imageViewNoMember"
                app:layout_constraintStart_toEndOf="@id/imageViewNoMember"/>

            <ImageView
                android:id="@+id/imageViewNoMember"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/nomember"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:ignore="contentDescription" />

            <TextView
                android:id="@+id/textViewNoMemberUnitInput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:text="0원/kWh"
                android:textSize="18sp"
                android:textColor="@color/black_600"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewNoMemberContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start"
                android:text="@string/nomemberInfoMessage"
                android:textSize="20sp"
                android:textColor="@color/gray_500"
                app:layout_constraintStart_toStartOf="@id/textViewNoMember"
                app:layout_constraintTop_toBottomOf="@id/textViewNoMember" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>