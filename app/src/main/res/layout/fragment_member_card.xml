<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="800dp"
    android:layout_height="380dp"
    tools:context=".pages.MemberCardFragment">

    <TextView
        android:id="@+id/textViewMemberCheckMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/memberCardTagMessage"
        android:textSize="34sp"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageViewMemberCardReader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/card_to_reader_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewMemberCheckMessage"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="contentDescription" />

    <ImageView
        android:id="@+id/imageViewMemberCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/member_card"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@id/imageViewMemberCardReader"
        app:layout_constraintBottom_toBottomOf="@id/imageViewMemberCardReader"
        tools:ignore="contentDescription" />

    <TextView
        android:id="@+id/textViewTagTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="20초"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="@id/imageViewMemberCardReader"
        app:layout_constraintEnd_toEndOf="@id/imageViewMemberCardReader"
        app:layout_constraintTop_toBottomOf="@id/imageViewMemberCardReader" />

    <TextView
        android:id="@+id/textViewMemberStopMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/memberCardTagStopMessage"
        android:textSize="20sp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/textViewMemberCheckMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>