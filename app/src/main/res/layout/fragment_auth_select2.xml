<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="800dp"
    android:layout_height="380dp"
    tools:context=".pages.AuthSelect2Fragment">

    <!--  환경부  -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewMoe"
        android:layout_width="370dp"
        android:layout_height="300dp"
        android:layout_marginStart="20dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMoe"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/layer_list_rect_corner">

            <TextView
                android:id="@+id/textViewMoe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/moeMessage"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/green"
                app:layout_constraintTop_toBottomOf="@id/imageViewMoe"
                app:layout_constraintStart_toStartOf="@id/imageViewMoe"
                app:layout_constraintEnd_toEndOf="@id/imageViewMoe" />

            <ImageView
                android:id="@+id/imageViewMoe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:background="@drawable/moe"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="contentDescription" />

            <TextView
                android:id="@+id/textViewMoeUnitInput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:text="0원/kWh"
                android:textSize="18sp"
                android:textColor="@color/black_600"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/textViewMoeContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="start"
                android:text="@string/moeInfoMessage"
                android:textSize="20sp"
                android:textColor="@color/gray_500"
                app:layout_constraintStart_toStartOf="@id/textViewMoe"
                app:layout_constraintTop_toBottomOf="@id/textViewMoe"
                app:layout_constraintEnd_toEndOf="@id/textViewMoe"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!--  member info  -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewMember"
        android:layout_width="370dp"
        android:layout_height="300dp"
        android:layout_marginStart="20dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/cardViewMoe"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMember"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/layer_list_rect_corner">

            <TextView
                android:id="@+id/textViewMember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/memberMessage"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                app:layout_constraintTop_toBottomOf="@id/imageViewMember"
                app:layout_constraintStart_toStartOf="@id/imageViewMember"
                app:layout_constraintEnd_toEndOf="@id/imageViewMember" />

            <ImageView
                android:id="@+id/imageViewMember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:background="@drawable/member"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:ignore="contentDescription" />

            <TextView
                android:id="@+id/textViewMemberUnitInput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:text="0원/kWh"
                android:textSize="18sp"
                android:textColor="@color/black_600"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/textViewMemberContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="start"
                android:text="@string/memberInfoMessage"
                android:textSize="20sp"
                android:textColor="@color/gray_500"
                app:layout_constraintStart_toStartOf="@id/textViewMember"
                app:layout_constraintTop_toBottomOf="@id/textViewMember"
                app:layout_constraintEnd_toEndOf="@id/textViewMember"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>