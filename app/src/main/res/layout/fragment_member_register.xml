<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="800dp"
    android:layout_height="480dp"
    tools:context=".pages.MemberRegisterFragment">

    <TextView
        android:id="@+id/tvMemberRegisterTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/memberRegisterTitle"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <ScrollView
        android:id="@+id/scrollCardList"
        android:layout_width="500dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvMemberRegisterTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/llButtons">

        <LinearLayout
            android:id="@+id/llCardList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />

    </ScrollView>

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/memberListEmpty"
        android:textSize="24sp"
        android:textColor="#999999"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/scrollCardList"
        app:layout_constraintBottom_toBottomOf="@id/scrollCardList"
        app:layout_constraintLeft_toLeftOf="@id/scrollCardList"
        app:layout_constraintRight_toRightOf="@id/scrollCardList" />

    <LinearLayout
        android:id="@+id/llButtons"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvMemberRegisterTitle"
        app:layout_constraintRight_toRightOf="parent">

        <Button
            android:id="@+id/btnMemberRegisterAdd"
            android:layout_width="220dp"
            android:layout_height="80dp"
            android:layout_marginBottom="20dp"
            android:text="@string/btnMemberRegister"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/shape_btn_blue"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnMemberDeleteMode"
            android:layout_width="220dp"
            android:layout_height="80dp"
            android:layout_marginBottom="20dp"
            android:text="@string/btnMemberDeleteMode"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/shape_btn_white_stroke_blue_rounded"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnMemberDeleteConfirm"
            android:layout_width="220dp"
            android:layout_height="80dp"
            android:layout_marginBottom="20dp"
            android:text="@string/btnMemberDeleteConfirm"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/shape_btn_red"
            app:backgroundTint="@null"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnMemberRegisterExit"
            android:layout_width="220dp"
            android:layout_height="80dp"
            android:text="@string/btnConfigExit"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/selector_default_btn"
            app:backgroundTint="@null" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>